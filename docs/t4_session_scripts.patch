diff --git a/scripts/h2h_compare.py b/scripts/h2h_compare.py
new file mode 100644
index 0000000..7994f8a
--- /dev/null
+++ b/scripts/h2h_compare.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Side-by-side of two head-to-head result trees (A10 vs T4), same suite and level.
+
+    python3 scripts/h2h_compare.py results/head-to-head-a10 results/head-to-head-t4 \\
+        --pair vllm=vllm-c8k-u090 --pair qvac-q4km-cram0=qvac-q4km-cram0-c8k-np8
+
+Each `--pair A=B` matches engine directory A under the first root with B under
+the second. Suites are matched by canonical name: a trailing `_r2` / `_short`
+is dropped, so the A10's `A_warm_r2` meets the T4's `A_warm_short`. Only
+concurrency levels present on both sides are compared.
+
+Columns are the h2h_report.py ones (per-user decode p50, aggregate wall tok/s,
+TTFT p50 / p95, cache hit) for each card, plus T4/A10 ratios. A mismatch in
+prompt tokens, max_tokens or cache mode is printed above the table and the
+table is still produced: a 4k-context T4 run against the 7000-token A10 run is
+a legitimate (labelled) comparison, not an error. Peak VRAM comes from each
+directory's gpu.csv.
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import statistics
+import sys
+from pathlib import Path
+
+from h2h_report import load, prefill_and_cache
+
+
+def canon(suite: str) -> str:
+    return re.sub(r"_(r2|short)$", "", suite)
+
+
+def level_means(levels: list[dict]) -> dict[int, dict]:
+    out = {}
+    for c in sorted({x["concurrency"] for x in levels}):
+        ls = [x for x in levels if x["concurrency"] == c]
+        hit = [p[1] for p in map(prefill_and_cache, ls) if p[1] is not None]
+
+        def mean(key):
+            v = [x.get(key) for x in ls if x.get(key) is not None]
+            return statistics.fmean(v) if v else None
+        out[c] = {"decode": mean("per_user_decode_tok_s_p50"),
+                  "aggr": mean("aggregate_decode_tok_s"),
+                  "ttft50": mean("ttft_ms_p50"), "ttft95": mean("ttft_ms_p95"),
+                  "hit": statistics.fmean(hit) if hit else None,
+                  "fail": sum(x["failures"] for x in ls), "reps": len(ls)}
+    return out
+
+
+def suites_in(d: Path) -> dict[str, Path]:
+    found = {}
+    for p in sorted(d.glob("*.jsonl")):
+        if p.stem in ("boot", "quality", "matrix"):
+            continue
+        try:
+            header, levels, _ = load(p)
+        except Exception:
+            continue
+        if header.get("kind") == "header" and levels:
+            found[canon(p.stem)] = p
+    return found
+
+
+def peak_vram(d: Path) -> str:
+    p = d / "gpu.csv"
+    if not p.exists():
+        return "-"
+    peak = 0
+    for line in p.read_text().splitlines()[1:]:
+        f = line.split(",")
+        if len(f) > 3:
+            m = re.search(r"\d+", f[3])
+            if m:
+                peak = max(peak, int(m.group()))
+    return f"{peak} MiB" if peak else "-"
+
+
+def f(v, nd=1):
+    return "-" if v is None else f"{v:.{nd}f}"
+
+
+def ratio(t4, a10):
+    return "-" if not t4 or not a10 else f"{t4 / a10:.2f}x"
+
+
+def pct(v):
+    return "-" if v is None else f"{100 * v:.0f}%"
+
+
+def compare(root_a: Path, root_b: Path, ea: str, eb: str) -> list[str]:
+    da, db = root_a / ea, root_b / eb
+    out = [f"### {ea} (A10) vs {eb} (T4)", "",
+           f"Peak VRAM from gpu.csv: A10 {peak_vram(da)}, T4 {peak_vram(db)}", ""]
+    sa, sb = suites_in(da), suites_in(db)
+    for suite in sorted(set(sa) & set(sb)):
+        ha, la, _ = load(sa[suite])
+        hb, lb, _ = load(sb[suite])
+        warn = [f"{k}: A10 {ha.get(k)} vs T4 {hb.get(k)}"
+                for k in ("prompt_tokens_target", "max_tokens", "cache_mode")
+                if ha.get(k) != hb.get(k)]
+        ma, mb = level_means(la), level_means(lb)
+        out += [f"#### {suite}  (A10 file {sa[suite].name}, T4 file {sb[suite].name})", ""]
+        if warn:
+            out += ["> SHAPE MISMATCH: " + "; ".join(warn), ""]
+        out += ["| conc | decode A10 | decode T4 | T4/A10 | aggr A10 | aggr T4 | T4/A10 "
+                "| TTFT p50 A10 | T4 | p95 A10 | T4 | cache A10 | T4 | fail A10/T4 |",
+                "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
+        for c in sorted(set(ma) & set(mb)):
+            a, b = ma[c], mb[c]
+            out.append(
+                f"| {c} | {f(a['decode'])} | {f(b['decode'])} | {ratio(b['decode'], a['decode'])} "
+                f"| {f(a['aggr'])} | {f(b['aggr'])} | {ratio(b['aggr'], a['aggr'])} "
+                f"| {f(a['ttft50'], 0)} | {f(b['ttft50'], 0)} | {f(a['ttft95'], 0)} | {f(b['ttft95'], 0)} "
+                f"| {pct(a['hit'])} | {pct(b['hit'])} | {a['fail']}/{b['fail']} |")
+        out += ["", f"_reps: A10 {sorted({v['reps'] for v in ma.values()})}, "
+                    f"T4 {sorted({v['reps'] for v in mb.values()})}; levels compared: "
+                    f"{sorted(set(ma) & set(mb))}_", ""]
+    only_a, only_b = sorted(set(sa) - set(sb)), sorted(set(sb) - set(sa))
+    if only_a or only_b:
+        out.append(f"_not compared: A10-only {only_a}, T4-only {only_b}_")
+    return out
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("root_a10", type=Path)
+    ap.add_argument("root_t4", type=Path)
+    ap.add_argument("--pair", action="append", required=True, metavar="A10DIR=T4DIR")
+    args = ap.parse_args()
+    for pair in args.pair:
+        ea, _, eb = pair.partition("=")
+        if not eb or not (args.root_a10 / ea).is_dir() or not (args.root_t4 / eb).is_dir():
+            print(f"skip pair {pair!r}: directory missing", file=sys.stderr)
+            continue
+        print("\n".join(compare(args.root_a10, args.root_t4, ea, eb)))
+        print()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    sys.exit(main())
diff --git a/scripts/h2h_curve.py b/scripts/h2h_curve.py
new file mode 100644
index 0000000..72c444e
--- /dev/null
+++ b/scripts/h2h_curve.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Context-length curve from one result tree: decode, aggregate, TTFT and VRAM by prompt length.
+
+    python3 scripts/h2h_curve.py results/head-to-head-t4 \\
+        --group "QVAC=qvac-q4km-cram0-c8k-np8,qvac-q4km-cram0-c4k-np8,qvac-q4km-cram0-c2k-np8,qvac-q4km-cram0-c1k-np8" \\
+        --group "vLLM 0.85=vllm-c8k-u085,vllm-c4k-u085,vllm-c2k-u085,vllm-c1k-u085"
+
+Each --group NAME=DIR,DIR,... is one engine config; directories are sorted by the prompt
+length recorded in the A_warm / A_cold header. One table per suite, rows by prompt length,
+columns at the requested concurrency levels (default 1,5,8). Missing suites show "-".
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+from h2h_compare import f, level_means, peak_vram, suites_in
+from h2h_report import load
+
+
+def rows_for(root: Path, dirs: list[str], suite: str):
+    rows = []
+    for d in dirs:
+        p = root / d
+        if not p.is_dir():
+            continue
+        found = suites_in(p)
+        if suite not in found:
+            rows.append((10**9, d, None, None, peak_vram(p)))
+            continue
+        header, levels, _ = load(found[suite])
+        rows.append((header.get("prompt_tokens_target") or 0, d, header, level_means(levels), peak_vram(p)))
+    return sorted(rows, key=lambda r: -r[0] if r[0] < 10**9 else 0)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("root", type=Path)
+    ap.add_argument("--group", action="append", required=True, metavar="NAME=DIR,DIR")
+    ap.add_argument("--levels", default="1,5,8")
+    ap.add_argument("--suites", default="A_warm,A_cold")
+    args = ap.parse_args()
+    lv = [int(x) for x in args.levels.split(",")]
+    for suite in args.suites.split(","):
+        print(f"#### {suite}: decode tok/s per user p50 at {'/'.join(map(str, lv))} users; "
+              f"aggregate and TTFT p50 (ms) at {lv[-1]} users\n")
+        print("| Engine | Prompt tokens | Directory | Decode | Aggregate | TTFT p50 | Peak VRAM | Cache hit |")
+        print("|---|---|---|---|---|---|---|---|")
+        for g in args.group:
+            name, _, dirs = g.partition("=")
+            for pt, d, hdr, m, vram in rows_for(args.root, dirs.split(","), suite):
+                if m is None:
+                    print(f"| {name} | - | {d} | - | - | - | {vram} | - |")
+                    continue
+                dec = " / ".join(f(m[c]["decode"]) if c in m else "-" for c in lv)
+                last = m.get(lv[-1])
+                hit = f"{100 * last['hit']:.0f}%" if last and last["hit"] is not None else "-"
+                print(f"| {name} | {pt} | {d} | {dec} | {f(last['aggr']) if last else '-'} "
+                      f"| {f(last['ttft50'], 0) if last else '-'} | {vram} | {hit} |")
+        print()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    sys.exit(main())
