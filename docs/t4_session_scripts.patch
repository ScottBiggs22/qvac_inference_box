diff --git a/scripts/t4_ctx_curve.sh b/scripts/t4_ctx_curve.sh
new file mode 100644
index 0000000..843462c
--- /dev/null
+++ b/scripts/t4_ctx_curve.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# T4 context-length scaling curve: the shorter-context points that join
+# t4_suites.sh's 8k (7000+512) and 4k (3500+512) runs, so decode speed, prefill
+# and TTFT can be plotted against prompt length at the same levels (1, 5, 8).
+#
+#   prompt  server ctx   from
+#    7000     8192       t4_suites.sh   (qvac-q4km-cram0-c8k-np8, vllm-c8k-u090)
+#    3500     4096       t4_suites.sh   (qvac-q4km-cram0-c4k-np8, vllm-c4k-u085)
+#    1500     2048       this script    (c2k)
+#     500     1024       this script    (c1k)
+#
+# Slots are held at 8 (QVAC) so only the context changes. Per-slot KV shrinks
+# with it (144 KiB/token), so the same card has room for far more slots at
+# 2k/1k; that capacity trade is arithmetic plus the t4_sweep.sh loads, and is
+# not re-measured here.
+#
+# Waits for t4_suites.sh to finish first (the GPU is single-tenant).
+#   bash scripts/t4_ctx_curve.sh
+set -uo pipefail
+H2H=/root/h2h; REPO=/root/repo; O=$H2H/out/t4; Q4=/root/models/Qwen3-8B-Q4_K_M.gguf
+# shellcheck disable=SC1091
+. $H2H/env.sh
+export GGUF=$Q4 FA=${FA:-auto}
+step() { echo "STEP $* $(date -u +%T)"; }
+
+# Standalone now: the earlier wait on /root/suites.out is only needed when queued behind t4_suites.sh.
+[ "${WAIT_FOR_SUITES:-0}" = 1 ] && until grep -q SUITES_EXIT /root/suites.out 2>/dev/null; do sleep 30; done
+step "ctx curve start"
+
+# run NAME ENGINE CTX PROMPT_TOKENS NP UTIL SUITES -- engine flags  (as t4_suites.sh)
+run() {
+  local name=$1 e=$2 ctx=$3 pt=$4 np=$5 util=$6 suites=$7; shift 8
+  step "$name up"
+  CTX=$ctx NP=$np VLLM_GPU_UTIL=$util bash $REPO/scripts/h2h_serve.sh start "$e" "$name" "$@" > /dev/null
+  for _ in $(seq 1 6000); do curl -sf localhost:8000/health > /dev/null && break; sleep 0.2; done
+  if ! curl -sf localhost:8000/health > /dev/null; then
+    echo "  $name did not come up"; tail -20 $H2H/logs/$name.log; return 1
+  fi
+  mkdir -p "$O/$name"
+  cp $H2H/run/$name.cmd "$O/$name/" 2>/dev/null
+  CTX=$ctx PROMPT_TOKENS=$pt bash $REPO/scripts/h2h_bench.sh "$O/$name" $suites > "$O/$name/bench.out" 2>&1
+  cp $H2H/logs/$name.log "$O/$name/server.log"
+  bash $REPO/scripts/h2h_serve.sh stop > /dev/null
+  step "$name done"
+}
+
+for cfg in "2048 1500 c2k" "1024 500 c1k"; do
+  set -- $cfg
+  run qvac-q4km-cram0-$3-np8 qvac "$1" "$2" 8 - "smoke A_warm_short A_cold_short" -- -cram 0
+done
+for cfg in "2048 1500 c2k" "1024 500 c1k"; do
+  set -- $cfg
+  run vllm-$3-u085 vllm "$1" "$2" 0 0.85 "smoke A_warm_short A_cold_short" -- --dtype half
+done
+step CURVE_DONE
