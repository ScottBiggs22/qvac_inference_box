+++ b/scripts/t4_parity.sh
@@ -0,0 +1,52 @@
+#!/usr/bin/env bash
+# The A10 head-to-head's non-throughput axes, on the T4: start-up timings
+# (HEAD_TO_HEAD.md §8) and quality parity (§10). QVAC at the ACA shape
+# (5 slots x 8192, -cram 0), vLLM at the handoff's flags (0.85, --dtype half).
+# Output: /root/h2h/out/t4/parity/
+#   bash scripts/t4_parity.sh
+# Run from a FILE under setsid nohup (docs/VAST_AI_OPERATIONS.md §7).
+set -uo pipefail
+H2H=/root/h2h; REPO=/root/repo; O=$H2H/out/t4/parity; Q4=/root/models/Qwen3-8B-Q4_K_M.gguf
+mkdir -p "$O"
+# shellcheck disable=SC1091
+. $H2H/env.sh
+export GGUF=$Q4 FA=${FA:-auto} CTX=8192
+step() { echo "STEP $* $(date -u +%T)"; }
+
+wait_up() {
+  for _ in $(seq 1 9000); do curl -sf localhost:8000/health > /dev/null && return 0; sleep 0.2; done
+  return 1
+}
+
+step "qvac boot timings"
+for mode in warm cold_weights; do
+  NP=5 python3 $REPO/scripts/h2h_boot_timer.py qvac "qvac-boot-$mode" --mode $mode \
+    -o $O/qvac_boot.jsonl --timeout 600 -- -cram 0 > $O/qvac-boot-$mode.out 2>&1
+done
+step "qvac quality"
+NP=5 bash $REPO/scripts/h2h_serve.sh start qvac qvac-parity -cram 0 > /dev/null
+if wait_up; then
+  python3 $REPO/scripts/h2h_quality.py run --label qvac-q4km-t4 --api-key "$API_KEY" \
+    -o $O/quality_qvac.jsonl > $O/quality_qvac.out 2>&1
+else echo "qvac did not come up" > $O/quality_qvac.out; fi
+cp $H2H/logs/qvac-parity.log $O/qvac-parity.server.log 2>/dev/null
+bash $REPO/scripts/h2h_serve.sh stop > /dev/null
+
+step "vllm boot timings"
+for mode in warm cold_full; do
+  VLLM_GPU_UTIL=0.85 python3 $REPO/scripts/h2h_boot_timer.py vllm "vllm-boot-$mode" --mode $mode \
+    -o $O/vllm_boot.jsonl --timeout 1500 -- --dtype half > $O/vllm-boot-$mode.out 2>&1
+done
+step "vllm quality"
+VLLM_GPU_UTIL=0.85 bash $REPO/scripts/h2h_serve.sh start vllm vllm-parity --dtype half \
+  --enable-auto-tool-choice --tool-call-parser hermes > /dev/null   # A10 quality run needed these for tool calls
+if wait_up; then
+  python3 $REPO/scripts/h2h_quality.py run --label vllm-awq-t4 --api-key "$API_KEY" \
+    -o $O/quality_vllm.jsonl > $O/quality_vllm.out 2>&1
+else echo "vllm did not come up" > $O/quality_vllm.out; fi
+cp $H2H/logs/vllm-parity.log $O/vllm-parity.server.log 2>/dev/null
+bash $REPO/scripts/h2h_serve.sh stop > /dev/null
+
+[ -f $O/quality_qvac.jsonl ] && [ -f $O/quality_vllm.jsonl ] \
+  && python3 $REPO/scripts/h2h_quality.py compare $O/quality_vllm.jsonl $O/quality_qvac.jsonl > $O/quality_compare.txt 2>&1
+step PARITY_DONE
