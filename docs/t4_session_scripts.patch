+++ b/scripts/t4_suites.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# T4 load suites on the configs the fit sweep (t4_sweep.sh) showed to load.
+# Same suite names, prompt shape and result layout as the A10 head-to-head, so
+# h2h_report.py reads both. One output directory per config under
+# /root/h2h/out/t4/, named like results/head-to-head-a10/:
+#
+#   qvac-q4km-cram0-c8k-np8   the A10 shape: 7000+512, 8 slots x 8192
+#   qvac-q4km-cram0-c8k-np5   the ACA shape: 5 slots x 8192 (+ devops suites)
+#   qvac-q4km-cram0-c4k-np8   4k context: 3500+512, 8 slots x 4096
+#   vllm-c8k-u090 / -u085     vLLM AWQ at 8192, 0.90 and 0.85 utilisation
+#   vllm-c4k-u085             vLLM AWQ at 4096, 0.85 (the ACA handoff value)
+#
+#   bash scripts/t4_suites.sh qvac | vllm | all
+# Run from a FILE under setsid nohup (docs/VAST_AI_OPERATIONS.md §7).
+set -uo pipefail
+H2H=/root/h2h; REPO=/root/repo; O=$H2H/out/t4; Q4=/root/models/Qwen3-8B-Q4_K_M.gguf
+mkdir -p "$O"
+# shellcheck disable=SC1091
+. $H2H/env.sh
+export GGUF=$Q4 FA=${FA:-auto}
+step() { echo "STEP $* $(date -u +%T)"; }
+
+# run NAME ENGINE CTX PROMPT_TOKENS NP UTIL SUITES -- engine flags
+run() {
+  local name=$1 e=$2 ctx=$3 pt=$4 np=$5 util=$6 suites=$7; shift 8
+  step "$name up"
+  CTX=$ctx NP=$np VLLM_GPU_UTIL=$util bash $REPO/scripts/h2h_serve.sh start "$e" "$name" "$@" > /dev/null
+  for _ in $(seq 1 6000); do curl -sf localhost:8000/health > /dev/null && break; sleep 0.2; done
+  if ! curl -sf localhost:8000/health > /dev/null; then
+    echo "  $name did not come up"; tail -20 $H2H/logs/$name.log; return 1
+  fi
+  mkdir -p "$O/$name"
+  cp $H2H/run/$name.cmd "$O/$name/" 2>/dev/null
+  CTX=$ctx PROMPT_TOKENS=$pt bash $REPO/scripts/h2h_bench.sh "$O/$name" $suites > "$O/$name/bench.out" 2>&1
+  cp $H2H/logs/$name.log "$O/$name/server.log"
+  grep -ihE 'flash' $H2H/logs/$name.log | head -5 > "$O/$name/flash_attn.txt"
+  bash $REPO/scripts/h2h_serve.sh stop > /dev/null
+  step "$name done"
+}
+
+qvac() {
+  run qvac-q4km-cram0-c8k-np8 qvac 8192 7000 8 - "smoke A_warm_short A_cold_short F_cross E_sat" -- -cram 0
+  run qvac-q4km-cram0-c8k-np5 qvac 8192 7000 5 - "smoke A_warm_short A_cold_short devops_warm devops_cold" -- -cram 0
+  run qvac-q4km-cram0-c4k-np8 qvac 4096 3500 8 - "smoke A_warm_short A_cold_short" -- -cram 0
+}
+vllm() {
+  run vllm-c8k-u090 vllm 8192 7000 0 0.90 "smoke A_warm_short A_cold_short F_cross E_sat" -- --dtype half
+  run vllm-c8k-u085 vllm 8192 7000 0 0.85 "smoke A_warm_short A_cold_short devops_warm devops_cold" -- --dtype half
+  run vllm-c4k-u085 vllm 4096 3500 0 0.85 "smoke A_warm_short A_cold_short" -- --dtype half
+}
+
+# Single configs, for resuming a partial run without repeating finished ones.
+vllm_c8k_u085() { run vllm-c8k-u085 vllm 8192 7000 0 0.85 "${SUITES:-smoke A_warm_short A_cold_short devops_warm devops_cold}" -- --dtype half; }
+vllm_c4k_u085() { run vllm-c4k-u085 vllm 4096 3500 0 0.85 "${SUITES:-smoke A_warm_short A_cold_short}" -- --dtype half; }
+
+# Night-3 extras: isolation probes and repeats (docs/T4_HANDOFF.md to-do 4 and 5).
+# FA on/off for QVAC at 8k, vLLM FLEX_ATTENTION at 8k and 1k, second runs of the headline rows.
+extras_fa() {
+  FA=on  run qvac-c8k-np8-fa-on  qvac 8192 7000 8 - "smoke A_warm_short" -- -cram 0
+  FA=off run qvac-c8k-np8-fa-off qvac 8192 7000 8 - "smoke A_warm_short" -- -cram 0
+}
+extras_flex() {
+  run vllm-c8k-u085-flex vllm 8192 7000 0 0.85 "smoke A_warm_short" -- --dtype half --attention-backend FLEX_ATTENTION
+  run vllm-c1k-u085-flex vllm 1024 500 0 0.85 "smoke A_warm_short" -- --dtype half --attention-backend FLEX_ATTENTION
+}
+extras_rep() {
+  run vllm-c8k-u085-rep2 vllm 8192 7000 0 0.85 "devops_warm" -- --dtype half
+  run qvac-q4km-cram0-c8k-np5-rep2 qvac 8192 7000 5 - "devops_warm" -- -cram 0
+  run vllm-c1k-u085-rep2 vllm 1024 500 0 0.85 "A_warm_short" -- --dtype half
+  run qvac-q4km-cram0-c1k-np8-rep2 qvac 1024 500 8 - "A_warm_short" -- -cram 0
+}
+
+case "${1:-}" in
+  extras-fa) extras_fa ;; extras-flex) extras_flex ;; extras-rep) extras_rep ;;
+  qvac) qvac ;; vllm) vllm ;; all) qvac; vllm ;;
+  vllm-c8k-u085) vllm_c8k_u085 ;;   # SUITES="smoke A_warm_short devops_warm devops_cold" to skip cold
+  vllm-c4k-u085) vllm_c4k_u085 ;;
+  *) echo "usage: $0 {qvac|vllm|all|vllm-c8k-u085|vllm-c4k-u085}" >&2; exit 2 ;;
+esac
+step SUITES_DONE
diff --git a/scripts/t4_sweep.sh b/scripts/t4_sweep.sh
new file mode 100755
index 0000000..21a7007
--- /dev/null
+++ b/scripts/t4_sweep.sh
@@ -0,0 +1,82 @@
+#!/usr/bin/env bash
+# T4 fit sweep: does Qwen3-8B load, and what does it cost in VRAM, at 8k and 4k
+# context per sequence? Run from a FILE on the box (docs/VAST_AI_OPERATIONS.md §7),
+# after `t4_box.sh setup` (QVAC built for sm_75, GGUF on disk, env.sh written).
+#
+#   bash scripts/t4_sweep.sh qvac     QVAC at 8k x {8,5} and 4k x {12,8,5} slots, f16 and q8_0 KV
+#   bash scripts/t4_sweep.sh vllm     vLLM AWQ at max-model-len {8192,4096}, util {0.85,0.90}
+#   bash scripts/t4_sweep.sh all
+#
+# Each config is started, given one real 1-token completion (so lazily
+# allocated buffers are counted), sampled with nvidia-smi, then stopped. One
+# JSON line per config goes to $O/sweep.jsonl:
+#   {engine, name, ctx, np, kv, util, status, vram_mib, vram_total_mib,
+#    t_health_s, note}
+# status is up | failed | oom. The point is the failures as much as the fits:
+# they say which configs to drop before the full suites are run.
+set -uo pipefail
+H2H=/root/h2h; REPO=/root/repo; O=$H2H/out/t4; Q4=/root/models/Qwen3-8B-Q4_K_M.gguf
+mkdir -p "$O" "$H2H/logs"
+# shellcheck disable=SC1091
+. $H2H/env.sh
+export GGUF=$Q4 FA=${FA:-auto}
+TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | head -1)
+
+try() {  # try ENGINE NAME CTX NP KV UTIL TIMEOUT [engine flags...]
+  local e=$1 n=$2 ctx=$3 np=$4 kv=$5 util=$6 to=$7; shift 7
+  local t0 status=up note="" vram="" t_health=""
+  t0=$(date +%s.%N)
+  CTX=$ctx NP=$np VLLM_GPU_UTIL=$util bash $REPO/scripts/h2h_serve.sh start "$e" "$n" "$@" > /dev/null
+  local deadline=$(( $(date +%s) + to ))
+  until curl -sf localhost:8000/health > /dev/null; do
+    sleep 0.5
+    if ! kill -0 "$(cat $H2H/run/engine.pid 2>/dev/null)" 2>/dev/null; then status=failed; break; fi
+    [ "$(date +%s)" -gt "$deadline" ] && { status=failed; note="timeout ${to}s"; break; }
+  done
+  if [ "$status" = up ]; then
+    t_health=$(python3 -c "import time;print(round(time.time()-$t0,2))")
+    curl -s -m 120 -H "Authorization: Bearer $API_KEY" -H 'Content-Type: application/json' \
+      -d '{"model":"qwen3-8b","messages":[{"role":"user","content":"Say hi."}],"max_tokens":1}' \
+      localhost:8000/v1/chat/completions > /dev/null
+    sleep 2
+    vram=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
+  fi
+  if grep -qiE 'out of memory|OOM|cudaMalloc failed|failed to allocate' $H2H/logs/$n.log 2>/dev/null; then
+    [ "$status" = failed ] && status=oom
+    note="$note $(grep -iE 'out of memory|OOM|cudaMalloc failed|failed to allocate|available KV cache' $H2H/logs/$n.log | head -2 | tr '\n' ' ' | tr '"' "'")"
+  fi
+  # vLLM's own KV sizing and QVAC's flash-attention decision, in the engine's words.
+  grep -ihE 'GPU KV cache size|Maximum concurrency' $H2H/logs/$n.log 2>/dev/null | head -2 > $O/$n.kv.txt
+  grep -ihE 'flash' $H2H/logs/$n.log 2>/dev/null | head -3 > $O/$n.flash.txt
+  note="$note $(cat $O/$n.kv.txt 2>/dev/null | tr '\n' ' ' | tr '"' "'")"
+  printf '{"engine":"%s","name":"%s","ctx":%s,"np":%s,"kv":"%s","util":"%s","status":"%s","vram_mib":%s,"vram_total_mib":%s,"t_health_s":%s,"note":"%s"}\n' \
+    "$e" "$n" "$ctx" "$np" "$kv" "$util" "$status" "${vram:-null}" "$TOTAL" "${t_health:-null}" "$(echo $note)" | tee -a $O/sweep.jsonl
+  cp $H2H/logs/$n.log $O/$n.server.log 2>/dev/null
+  bash $REPO/scripts/h2h_serve.sh stop > /dev/null
+}
+
+qvac() {
+  # ctx np kv
+  for cfg in "8192 8 f16" "8192 5 f16" "8192 8 q8_0" "8192 5 q8_0" \
+             "4096 12 f16" "4096 8 f16" "4096 5 f16" "4096 12 q8_0"; do
+    set -- $cfg
+    kvflags=(); [ "$3" = q8_0 ] && kvflags=(-ctk q8_0 -ctv q8_0)
+    try qvac "sw-qvac-c$1-np$2-$3" "$1" "$2" "$3" "-" 300 -cram 0 ${kvflags[@]+"${kvflags[@]}"}
+  done
+}
+
+vllm() {
+  # ctx util. AWQ on Turing: --dtype half (no bf16), no forced FlashAttention-2.
+  for cfg in "8192 0.85" "8192 0.90" "4096 0.85" "4096 0.90"; do
+    set -- $cfg
+    try vllm "sw-vllm-c$1-u$2" "$1" 0 "awq" "$2" 1500 --dtype half
+  done
+}
+
+case "${1:-}" in
+  qvac) qvac ;;
+  vllm) vllm ;;
+  all)  qvac; vllm ;;
+  *) echo "usage: $0 {qvac|vllm|all}" >&2; exit 2 ;;
+esac
+echo "SWEEP_DONE $(date -u +%T)"
